<StructureDefinition xmlns="http://hl7.org/fhir">
  <id value="Profile-nNGM-Organization-Organisation" />
  <url value="http://uk-koeln.de/fhir/StructureDefinition/Organisation/nNGM" />
  <version value="1.0.0" />
  <name value="Profile_nNGM_Organization_Organisation" />
  <title value="Profile - nNGM - Organization - Organisation" />
  <status value="active" />
  <description value="Dieses Profil beschreibt ein Netzwerkzentrum, die Organisationszugehörigkeit (Organisation oder Abteilung) eines Behandlers und die Pathologien innerhalb des nNGM-Projektes." />
  <fhirVersion value="4.0.1" />
  <mapping>
    <identity value="v2" />
    <uri value="http://hl7.org/v2" />
    <name value="HL7 v2 Mapping" />
  </mapping>
  <mapping>
    <identity value="rim" />
    <uri value="http://hl7.org/v3" />
    <name value="RIM Mapping" />
  </mapping>
  <mapping>
    <identity value="servd" />
    <uri value="http://www.omg.org/spec/ServD/1.0/" />
    <name value="ServD" />
  </mapping>
  <mapping>
    <identity value="w5" />
    <uri value="http://hl7.org/fhir/fivews" />
    <name value="FiveWs Pattern Mapping" />
  </mapping>
  <kind value="resource" />
  <abstract value="false" />
  <type value="Organization" />
  <baseDefinition value="http://hl7.org/fhir/StructureDefinition/Organization" />
  <derivation value="constraint" />
  <differential>
    <element id="Organization">
      <path value="Organization" />
      <constraint>
        <key value="org-nngm-1" />
        <severity value="error" />
        <human value="Falls die Organisation eine Abteilung repräsentiert muss eine Verknüpfung auf die Hauptorganisation vorliegen" />
        <expression value="type.coding.where(system = 'http://snomed.info/sct' and code = '309912009').exists() implies partOf.exists()" />
      </constraint>
    </element>
    <element id="Organization.identifier">
      <path value="Organization.identifier" />
      <short value="Eindeutige Organisations-Id aus dem NMS System" />
      <min value="1" />
      <max value="1" />
    </element>
    <element id="Organization.identifier.system">
      <path value="Organization.identifier.system" />
      <min value="1" />
      <fixedUri value="http://uk-koeln.de/fhir/sid/nNGM/nms-organization" />
      <mustSupport value="true" />
    </element>
    <element id="Organization.identifier.value">
      <path value="Organization.identifier.value" />
      <short value="Unique organization identifier from the NMS System" />
      <definition value="This is a unique value which can be fetched from NMS Database via: https://nngm-nms.medicalsyn.com/api/v1.0/Public/Organization &#xD;&#xA;A &quot;internalSequenceIdentifier&quot; from the list must be choosen an set here" />
      <min value="1" />
      <mustSupport value="true" />
    </element>
    <element id="Organization.name">
      <path value="Organization.name" />
      <mustSupport value="true" />
      <mapping>
        <identity value="nNGM-Schema" />
        <map value="therapyExecutionCenter" />
        <comment value="Durchführende Einrichtung (Therapieempfehlung)" />
      </mapping>
    </element>
    <element id="Organization.telecom">
      <path value="Organization.telecom" />
      <max value="0" />
    </element>
    <element id="Organization.address">
      <path value="Organization.address" />
      <max value="0" />
    </element>
    <element id="Organization.partOf">
      <path value="Organization.partOf" />
      <max value="0" />
    </element>
    <element id="Organization.contact">
      <path value="Organization.contact" />
      <max value="0" />
    </element>
  </differential>
</StructureDefinition>
